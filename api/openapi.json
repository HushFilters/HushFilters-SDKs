{
  "openapi": "3.1.0",
  "info": {
    "title": "HushFilter API",
    "description": "Bloom filter based credential membership checking API",
    "version": "1.0.0"
  },
  "paths": {
    "/": {
      "get": {
        "tags": [
          "General"
        ],
        "summary": "Root",
        "description": "Hushfilters home page with product information and navigation.",
        "operationId": "root__get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "text/html": {
                "schema": {"type": "string"}
              }
            }
          }
        }
      }
    },
    "/endpoints": {
      "get": {
        "tags": ["General"],
        "summary": "Endpoints",
        "description": "API information and endpoint directory.",
        "operationId": "endpoints_endpoints_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/ui-check": {
      "get": {
        "tags": [
          "General"
        ],
        "summary": "Ui Check Redirect",
