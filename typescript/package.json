{
  "name": "hushclient-sdk",
  "version": "0.1.0",
  "description": "Typed Node.js SDK for the HushClient credential membership API",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "default": "./dist/index.js" }
  },
  "files": ["dist", "README.md"],
  "engines": { "node": ">=22" },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.examples.json --noEmit",
    "test": "npm run build && node --test test/client.test.mjs",
    "test:integration": "npm run build && node --test test/integration.test.mjs",
    "example": "npm run build && tsc -p tsconfig.examples.json && node dist-examples/basic.js",
    "example:sync": "npm run build && tsc -p tsconfig.examples.json && node dist-examples/sync.js",
    "prepack": "npm run build"
  },
  "devDependencies": { "@types/node": "^22.0.0", "typescript": "^5.9.3" }
}

